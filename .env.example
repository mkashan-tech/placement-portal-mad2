# Copy this file to .env (inside backend/) and fill in your own values.

# Flask secret key (used for session signing)
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# Optional: override the default SQLite database location
# DATABASE_URL=sqlite:///placement.db

# Redis (required for Celery broker/backend and Flask-Caching)
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# Mail (MailHog for local development — http://localhost:8025)
MAIL_SERVER=127.0.0.1
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_DEFAULT_SENDER=placement@portal.com

# Default admin account seeded on first run
DEFAULT_ADMIN_EMAIL=admin@ppa.com
DEFAULT_ADMIN_PASSWORD=admin123
